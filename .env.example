# Токен бота из @BotFather в StaticGram
BOT_TOKEN=
BOT_USERNAME=EpicGiftBot
# Адрес API StaticGram (совместим с Telegram Bot API)
API_ROOT=https://api.staticgram.top
# HTTPS-адрес, где открыт этот сервер (Mini App)
WEBAPP_URL=https://epicgift.example.com
# short_name приложения из /newapp (для реф-ссылок вида staticgram.top/<bot>/<app>?startapp=ref123), можно пусто
APP_SHORT_NAME=
# Аккаунт-ретранслятор (Premium + Business), на который игроки шлют NFT
RELAYER_USERNAME=epicgift_bank
# Можно не задавать — бот сам сохранит id при подключении бизнес-аккаунта
BUSINESS_CONNECTION_ID=
# Админы через запятую (их подарки на ретранслятор идут на склад апгрейдера)
ADMIN_IDS=123456789
PORT=3000
DB_PATH=./data/data.db

# Ракетка
CRASH_EDGE=0.10
CRASH_MAX=1000
BET_PHASE_MS=8000
MIN_BET=1
MAX_BET=100000
MAX_PAYOUT=0
# Апгрейдер
UPGRADE_EDGE=0.15
UPGRADE_MIN_CHANCE=0.01
UPGRADE_MAX_CHANCE=0.75
# Экономика
DEFAULT_NFT_PRICE=0
WAGER_MULT=1
RATE_LIMIT_PER_SEC=6
SELL_RATE=0.9
REF_PERCENT=10
MIN_WITHDRAW=100
# лимиты вывода (0 = без лимита)
WITHDRAW_MAX=0
WITHDRAW_DAILY=0
WITHDRAW_AUTO_LIMIT=0
# вывод больше суммы пополнений игрока — на одобрение админу (0 = выключить)
WITHDRAW_REVIEW_OVER_DEPOSIT=1
RATING_PRIZES=5000,2500,1000,500,250
